# Application
APP_NAME="Cloud Desktop Registration Portal"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai

# Managed invite codes. Keep this enabled for public-facing deployments.
INVITE_CODE=
INVITE_REQUIRED=true

# Admin console. Prefer ADMIN_PASSWORD_HASH and leave ADMIN_PASSWORD empty.
# Generate a hash with: php -r "echo password_hash('CHANGE_ME', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# AD / LDAP backend
# Use ldap when LDAPS/StartTLS is available. Use samba when password setup must be done through Samba RPC.
AD_BACKEND=ldap
AD_HOST=ad.example.local
AD_PORT=636
AD_USE_SSL=true
AD_START_TLS=false
AD_TLS_VERIFY=true
AD_TIMEOUT=8

# Service account. Do not commit real credentials.
AD_BIND_USER=ad-register-svc@example.local
AD_BIND_PASSWORD=

AD_DOMAIN=example.local
AD_UPN_SUFFIX=example.local
AD_BASE_DN=DC=example,DC=local
AD_USER_BASE_DN=CN=Users,DC=example,DC=local

# Group added after successful registration.
AD_GROUP_CN=VDI_Users
AD_GROUP_DN=CN=VDI_Users,CN=Users,DC=example,DC=local

# Account policy
AD_ENABLE_ACCOUNT=true
AD_PASSWORD_NEVER_EXPIRES=false
AD_CHANGE_PASSWORD_AT_NEXT_LOGON=false

# Samba RPC backend; used only when AD_BACKEND=samba.
AD_SAMBA_NET_PATH=/usr/bin/net
AD_SAMBA_DOMAIN=EXAMPLE
AD_SAMBA_USER=ad-register-svc
AD_SAMBA_PASSWORD=
AD_SAMBA_TIMEOUT=25
AD_SAMBA_LDAP_POST_UPDATE=true

# Form / rate limit
USERNAME_MIN_LENGTH=3
USERNAME_MAX_LENGTH=20
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_COMPLEXITY=true
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=600
